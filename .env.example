# ── 複製成 .env 後依環境調整 ────────────────────────────────────
# 資料庫後端：
#   postgres = 連線既有的 PostgreSQL（正式環境）
#   embedded = 以 pgserver 就地啟動一個 PostgreSQL（展示／測試，免安裝）
MES_DB_BACKEND=postgres
MES_DATABASE_URL=postgresql://mes:mes@localhost:5432/osat_mes
MES_DATABASE_NAME=osat_mes
MES_EMBEDDED_DATA_DIR=./data/pgdata
MES_DB_POOL_MIN=1
MES_DB_POOL_MAX=10

# JWT 與登入保護
MES_JWT_SECRET=change-me-to-a-long-random-string
MES_JWT_EXPIRE_MINUTES=480
MES_LOGIN_MAX_ATTEMPTS=5
MES_LOGIN_LOCKOUT_MINUTES=15

# 稽核紀錄保存期限（天）；超過的資料請先歸檔再清除
MES_AUDIT_RETENTION_DAYS=730

# 廠務設定
MES_FACTORY_CODE=OSAT-KH1
MES_TZ_OFFSET_HOURS=8
MES_SHIFT_START_HOURS=[8,20]

# 首次啟動自動建立的管理者帳號
MES_BOOTSTRAP_ADMIN=admin
MES_BOOTSTRAP_ADMIN_PASSWORD=admin1234

# Q-Time 逾時是否自動扣留批號
MES_AUTO_HOLD_ON_QTIME_VIOLATION=true

# SECS/GEM：啟動時是否自動連線所有啟用中的設備
# 開發／測試環境建議維持 false，避免沒有機台時一直重試連線
MES_SECS_AUTOSTART=false
